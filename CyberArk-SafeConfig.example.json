{
  "safe": {
    "description": "Safe dla {SafeName}",
    "location": "\\",
    "managingCPM": "PasswordManager",
    "olacEnabled": false,
    "numberOfDaysRetention": 10
  },
  "owner": {
    "role": "Owner",
    "groupSuffix": "_owner",
    "searchIn": "CORP"
  },
  "roles": {
    "Owner": {
      "useAccounts": true,
      "retrieveAccounts": true,
      "listAccounts": true,
      "addAccounts": true,
      "updateAccountContent": true,
      "updateAccountProperties": true,
      "initiateCPMAccountManagementOperations": true,
      "specifyNextAccountContent": true,
      "renameAccounts": true,
      "deleteAccounts": true,
      "unlockAccounts": true,
      "manageSafe": true,
      "manageSafeMembers": true,
      "viewAuditLog": true,
      "viewSafeMembers": true,
      "moveAccountsAndFolders": true
    },
    "Operator": {
      "useAccounts": true,
      "retrieveAccounts": true,
      "listAccounts": true,
      "updateAccountProperties": true,
      "initiateCPMAccountManagementOperations": true,
      "viewSafeMembers": true
    },
    "Auditor": {
      "listAccounts": true,
      "viewAuditLog": true,
      "viewSafeMembers": true
    }
  },
  "members": [
    {
      "name": "Vault Admins",
      "searchIn": "Vault",
      "role": "Owner"
    }
  ],
  "account": {
    "address": "corp.example.com",
    "platformId": "WinDomain",
    "secretType": "password",
    "platformAccountProperties": {
      "LogonDomain": "CORP"
    },
    "secretManagement": {
      "automaticManagementEnabled": true
    }
  },
  "defaults": {
    "pvwaUrl": "https://pvwa.example.com/PasswordVault",
    "authType": "LDAP",
    "accountUserName": "svc_sql",
    "accountSecretEnvironmentVariable": "CYBERARK_ACCOUNT_SECRET",
    "accountSecret": null,
    "adServer": "corp.example.com"
  }
}
