{
  "safe": {
    "description": "Safe dla {SafeName}",
    "location": "\\",
    "managingCPM": "PasswordManager",
    "numberOfVersionsRetention": 5,
    "olacEnabled": false
  },
  "owner": {
    "role": "Owner",
    "groupSuffix": "_owner",
    "searchIn": "CORP"
  },
  "roles": {
    "Owner": {
      "useAccounts": true,
      "retrieveAccounts": true,
      "listAccounts": true,
      "addAccounts": true,
      "updateAccountContent": true,
      "updateAccountProperties": true,
      "initiateCPMAccountManagementOperations": true,
      "specifyNextAccountContent": true,
      "renameAccounts": true,
      "deleteAccounts": true,
      "unlockAccounts": true,
      "manageSafe": true,
      "manageSafeMembers": true,
      "viewAuditLog": true,
      "viewSafeMembers": true,
      "moveAccountsAndFolders": true
    },
    "Operator": {
      "useAccounts": true,
      "retrieveAccounts": true,
      "listAccounts": true,
      "updateAccountProperties": true,
      "initiateCPMAccountManagementOperations": true,
      "viewSafeMembers": true
    },
    "Auditor": {
      "listAccounts": true,
      "viewAuditLog": true,
      "viewSafeMembers": true
    }
  },
  "members": [
    {
      "name": "PAM-Operators",
      "searchIn": "CORP",
      "role": "Operator"
    },
    {
      "name": "PAM-Auditors",
      "searchIn": "CORP",
      "role": "Auditor"
    }
  ],
  "account": {
    "address": "corp.example.com",
    "platformId": "WinDomain",
    "secretType": "password",
    "platformAccountProperties": {
      "LogonDomain": "CORP"
    },
    "secretManagement": {
      "automaticManagementEnabled": true
    }
  }
}
